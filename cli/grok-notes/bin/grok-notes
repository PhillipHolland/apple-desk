#!/bin/bash
# grok-notes — Apple Notes CLI (Notes.app JXA + local search index).
# Interim until MacStories / Viticci NotesCTL is public OSS. Not Club NotesCTL.
# Not jwmoss/notesctl (NoteStore.sqlite).
set -u
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR=$(cd -P "$(dirname "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT=$(cd -P "$(dirname "$SOURCE")/.." && pwd)
exec python3 "$ROOT/lib/cli.py" "$@"
