#!/bin/bash
# grok-mail — Apple Mail CLI (Mail.app JXA).
# Compatibility launcher for apple-desk mail; sends require explicit authorization, --force and an operation key.
set -u
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR=$(cd -P "$(dirname "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT=$(cd -P "$(dirname "$SOURCE")/.." && pwd)
exec python3 "$ROOT/lib/cli.py" "$@"
